# SKT-AI-LABS Agent Development Kit
# Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================
# LLM API KEYS (At least one required)
# ============================================================

# Google Gemini (Recommended - free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI GPT
OPENAI_API_KEY=your_openai_api_key_here

# Groq (Fast, cheap - Llama, Mixtral)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# SEARCH API KEYS (Optional - falls back to free providers)
# ============================================================

# Tavily AI Search (Best quality, 1000 free queries/month)
TAVILY_API_KEY=your_tavily_key_here

# Brave Search API (2000 queries/month free)
BRAVE_API_KEY=your_brave_key_here

# SerpAPI (Google results, 100 free queries/month)
SERPAPI_KEY=your_serpapi_key_here

# ============================================================
# DATABASE (Required for RAG with pgvector)
# ============================================================

# PostgreSQL with pgvector extension
DATABASE_URL=postgresql://user:password@localhost:5432/skt_db

# ============================================================
# VECTOR STORE CONFIGURATION
# ============================================================

# Options: chroma, pgvector, faiss, redis
VECTOR_STORE_TYPE=chroma

# Path for ChromaDB persistence
VECTOR_STORE_PATH=./skt_vector_db

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Redis URL (if using Redis vector store)
REDIS_URL=redis://localhost:6379

# ============================================================
# BROWSER CONFIGURATION
# ============================================================

# Headless mode (true for production, false for debugging)
BROWSER_HEADLESS=true

# Page load timeout in milliseconds
BROWSER_TIMEOUT=30000

# Anti-bot detection evasion
BROWSER_ANTI_BOT=true

# Proxy (optional)
# BROWSER_PROXY=http://proxy:8080

# ============================================================
# AGENT SETTINGS
# ============================================================

# Maximum iterations per agent run
AGENT_MAX_ITERATIONS=15

# Maximum concurrent operations
AGENT_MAX_CONCURRENT=10

# Maximum run duration in seconds
AGENT_MAX_DURATION=300

# Token budget for context window
AGENT_TOKEN_BUDGET=128000

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# development, staging, production
APP_MODE=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated, or * for all)
API_CORS_ORIGINS=*
